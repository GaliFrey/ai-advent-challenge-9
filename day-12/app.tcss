Screen {
    background: #101722;
    color: #dbe4f0;
}

#brand {
    height: 3;
    padding: 1 2 0 2;
    background: #172232;
}

#title {
    width: 24;
    color: #8ed6dc;
    text-style: bold;
}

#subtitle {
    width: 1fr;
    text-align: right;
    color: #899ab2;
}

#configuration {
    height: 5;
    padding: 1 2 0 2;
    background: #141e2c;
}

.config-label {
    width: auto;
    height: 3;
    padding: 1 1 0 0;
    color: #aebed3;
}

.spaced { margin-left: 2; }
#model { width: 22; }
#profile { width: 24; }
#session { width: 14; }

#configuration Button {
    width: 1fr;
    min-width: 15;
    margin-left: 1;
}

#scope {
    height: 2;
    padding: 0 2;
    background: #192536;
    color: #e7c47b;
    text-style: bold;
}

#workspace {
    height: 1fr;
    padding: 1;
}

#chat-panel, #profile-panel {
    width: 1fr;
    min-width: 52;
    margin: 0 1;
    padding: 1;
    border: round #34465d;
    background: #141e2c;
}

.panel-title {
    height: 2;
    color: #8ed6dc;
    text-style: bold;
}

.content {
    height: 1fr;
    min-height: 10;
    padding: 0 1;
    background: #101925;
    border: solid #26384d;
}

#right-tabs { height: 1fr; }
#profile-tab { padding: 0 1; }
#profile-tab Label { height: 1; color: #aebed3; }
#profile-tab Input { margin: 0 0 1 0; }

#stats {
    height: 3;
    margin-top: 1;
    padding: 1;
    background: #192536;
    color: #aebed3;
}

Input {
    height: 3;
    border: tall #34465d;
    background: #101925;
}

#message { margin-top: 1; }
Input:focus { border: tall #79c5d8; }
#chat-actions, #profile-actions { height: 4; }

#profile-notice {
    height: 2;
    color: #e7c47b;
}

Button {
    width: 1fr;
    min-width: 12;
    margin: 1 1 0 0;
    border: none;
}

Button.-primary {
    background: #386679;
    color: #f1f8fa;
}

Button.danger {
    background: #493a42;
    color: #efd9df;
}

#status {
    height: 2;
    padding: 0 2;
    color: #8ed6dc;
}

Footer {
    background: #172232;
    color: #9dafc6;
}
