Screen { background: #101722; color: #dbe4f0; }
#brand { height: 3; padding: 1 2 0 2; background: #172232; }
#title { width: 24; color: #8ed6dc; text-style: bold; }
#subtitle { width: 1fr; text-align: right; color: #899ab2; }
#configuration { height: 3; padding: 1 2; background: #141e2c; }
.config-label { width: auto; height: 1; padding: 0 1 0 0; color: #aebed3; }
.spaced { margin-left: 2; }
#model { width: 22; }
#profile { width: 26; }
#task { width: 14; }
#configuration Select { height: 1; }
#configuration Button { height: 1; margin: 0 0 0 1; padding: 0 1; border: none; content-align: center middle; }
#configuration #new-task { width: 14; }
#configuration #demo { width: 22; }
#scope { height: 2; padding: 0 2; background: #192536; color: #e7c47b; text-style: bold; }
#model-map { height: 2; padding: 0 2; background: #111a27; color: #8ed6dc; }
.panel-title { height: 2; color: #8ed6dc; text-style: bold; }
#goal-bar { height: 7; margin: 1 2 0 2; padding: 1; border: round #34465d; background: #141e2c; }
#goal-label { width: 7; height: 3; padding: 1 1 0 0; color: #8ed6dc; text-style: bold; }
#goal { width: 1fr; height: 3; border: tall #34465d; background: #101925; }
#goal:focus { border: tall #79c5d8; }
#goal-bar Button { width: auto; min-width: 12; height: 3; margin: 0 0 0 1; padding: 0 2; }
#goal-bar #run { min-width: 23; }
#stage-chain { height: 7; margin: 0 2; padding: 1; background: #111a27; border: round #2d4056; align-horizontal: center; }
#stage-chain .stage-node { width: 1fr; min-width: 17; height: 3; margin: 0; background: #1b293a; color: #9caec4; border: none; content-align: center middle; }
#stage-chain .stage-node.complete { color: #b8d982; background: #1c312f; }
#stage-chain .stage-node.active { color: #f5fbff; background: #386679; text-style: bold; }
#stage-chain .stage-node.skipped { color: #66768b; }
#stage-chain .stage-node.viewing { outline: solid #e7c47b; }
.stage-arrow { width: 5; height: 3; padding: 1 0; text-align: center; color: #52677f; }
#workspace { height: 1fr; padding: 0 1 1 1; }
#chat-panel, #tech-panel { margin: 0 1; padding: 1; border: round #34465d; background: #141e2c; }
#chat-panel { width: 2fr; min-width: 58; }
#tech-panel { width: 1fr; min-width: 38; }
#state { height: 17; padding: 1; background: #101925; border: solid #26384d; }
#prompt-title { margin-top: 1; }
.content { height: 1fr; min-height: 10; padding: 0 1; background: #101925; border: solid #26384d; }
Button { width: 1fr; min-width: 12; margin: 1 1 0 0; border: none; }
Button.-primary { background: #386679; color: #f1f8fa; }
#status { height: 2; padding: 0 2; color: #8ed6dc; }
Footer { background: #172232; color: #9dafc6; }
