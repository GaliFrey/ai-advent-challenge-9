TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
DEEPSEEK_API_KEY=
ASSISTANT_DB=data/assistant.sqlite3
# Общий срок обработки одного сообщения, включая все вызовы и сжатие контекста.
ASSISTANT_PROCESSING_TIMEOUT=120

# Опциональный локальный голос: uv sync --locked --extra voice
# Затем: uv run python -m personal_assistent.setup_voice
# Совместный запуск: uv run python -m personal_assistent.launch
ASSISTANT_VOICE_ENABLED=false
VOICE_SERVICE_URL=http://127.0.0.1:8765
VOICE_SERVICE_HOST=127.0.0.1
VOICE_SERVICE_PORT=8765
# Обязателен при подключении/прослушивании вне localhost.
VOICE_SERVICE_TOKEN=
VOICE_MODEL_DIR=data/voice-models
VOICE_MAX_BYTES=10485760
VOICE_MAX_SECONDS=300
VOICE_TIMEOUT=90
VOICE_CPU_THREADS=8

# Управление генерацией; модель остаётся deepseek-flash.
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=2000

# Прикладной бюджет в единицах консервативной оценки (не окно провайдера).
# Входная оценка + резерв <= бюджет. Резерв >= max(DEEPSEEK_MAX_TOKENS, 1000).
ASSISTANT_CONTEXT_BUDGET=60000
# Если не задан, резерв равен max(DEEPSEEK_MAX_TOKENS, 1000).
# ASSISTANT_CONTEXT_RESERVE=2000
