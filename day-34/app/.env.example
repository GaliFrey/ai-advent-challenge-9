# Local backend configuration. Never commit .env or put the key in browser code.
# Existing system environment values take priority over .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_HISTORY_MESSAGES=20
DEEPSEEK_HISTORY_CHARS=16000
DEEPSEEK_RAG_FRAGMENTS=3
DEEPSEEK_RAG_CHARS=12000
DEEPSEEK_MESSAGES_BYTES=65536
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_ANSWER_CHARS=4000
DEEPSEEK_SESSION_ATTEMPTS=10
DEEPSEEK_SESSION_WINDOW_SECONDS=3600
DEEPSEEK_CONNECT_SECONDS=5
DEEPSEEK_READ_SECONDS=45
DEEPSEEK_WRITE_SECONDS=10
DEEPSEEK_POOL_SECONDS=5
DEEPSEEK_TOTAL_SECONDS=90
