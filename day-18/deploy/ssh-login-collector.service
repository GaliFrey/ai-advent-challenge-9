[Unit]
Description=Collect successful SSH authentications for AI Advent day 18
After=systemd-journald.service

[Service]
Type=oneshot
User=heimdall
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/heimdall/ai-advent-day18
ExecStart=/home/heimdall/.local/bin/uv run --locked --no-sync python collect.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
