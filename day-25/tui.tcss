Screen { background: #101722; color: #dbe4f0; }
Static { height: auto; }
#brand { height: 2; padding: 0 2; text-style: bold; color: #8ed6dc; background: #172232; }
#toolbar { height: 3; padding: 0 1; }
#sessions { width: 1fr; }
Button { width: auto; min-width: 12; margin-left: 1; }
#cost { height: 1; padding: 0 2; color: #a9b9cc; }
#status { height: 3; padding: 0 2; color: #e7c47b; }
TabbedContent, ContentSwitcher, TabPane { height: 1fr; }
#workspace, #retrieval { height: 1fr; }
#chat-scroll { width: 2fr; border: round #8ed6dc; padding: 1 2; }
#memory-scroll { width: 1fr; border: round #34465d; padding: 1 2; }
#query { height: auto; max-height: 7; padding: 0 1; }
#chunks { width: 1fr; height: 1fr; }
#chunk-scroll { width: 1fr; border: round #34465d; padding: 1 2; }
#evidence-scroll { height: 12; border: round #34465d; padding: 1 2; }
#summary { height: 2fr; }
#assessment-scroll { height: 1fr; padding: 1 2; }
#composer { height: 5; padding: 0 1; }
#input { width: 1fr; height: 5; }
#send { width: 18; height: 3; margin-top: 1; }
#settings-tab Input { width: 30; }
#settings-scroll { padding: 1 2; }
.setting-title { margin-top: 1; text-style: bold; color: #8ed6dc; }
.setting-help { max-width: 110; color: #a9b9cc; margin-bottom: 1; }
