Screen { background: #101722; color: #dbe4f0; }
#brand { height: 3; padding: 1 2 0 2; background: #172232; }
#title { width: 24; color: #8ed6dc; text-style: bold; }
#subtitle { width: 1fr; text-align: right; color: #899ab2; }
#configuration { height: 5; padding: 1 2 0 2; background: #141e2c; }
.config-label { height: 3; content-align: left middle; color: #aebed3; }
.spaced { margin-left: 3; }
#profile-label { width: 26; }
#session-label { width: 18; }
#profile { width: 27; min-width: 27; height: 3; }
#session { width: 20; min-width: 20; height: 3; }
#configuration Button { height: 3; margin: 0 0 0 1; }
#new-session { width: 20; min-width: 20; }
#demo { width: 16; min-width: 16; }
#scope { height: 2; padding: 0 2; background: #192536; color: #e7c47b; text-style: bold; }
#workspace { height: 1fr; padding: 1; }
#chat-panel, #policy-panel { width: 1fr; min-width: 50; margin: 0 1; padding: 1; border: round #34465d; background: #141e2c; }
.panel-title { height: 2; color: #8ed6dc; text-style: bold; }
.content { height: 1fr; min-height: 10; padding: 0 1; background: #101925; border: solid #26384d; }
#tabs { height: 1fr; } #stats { height: 3; margin-top: 1; padding: 1; background: #192536; color: #aebed3; }
Input { height: 3; margin-top: 1; border: tall #34465d; background: #101925; }
Input:focus { border: tall #79c5d8; }
Button { min-width: 12; margin: 1 1 0 0; border: none; }
Button.-primary { background: #386679; color: #f1f8fa; }
#ask { width: 20; height: 3; }
#status { height: 2; padding: 0 2; color: #8ed6dc; }
Footer { background: #172232; color: #9dafc6; }
