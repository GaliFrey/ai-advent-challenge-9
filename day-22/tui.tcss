Screen { background: #101722; color: #dbe4f0; }
#brand { height: 2; padding: 0 2; color: #8ed6dc; text-style: bold; background: #172232; }
#run-status { height: 2; padding: 0 2; color: #e7c47b; background: #172232; }
#controls { height: 4; padding: 0 2; align: center middle; }
#question-label { width: 9; padding-top: 1; }
#question-select { width: 1fr; min-width: 30; margin-right: 1; }
#ask { width: 24; min-width: 24; margin-right: 1; }
#demo { width: 24; min-width: 24; }
#flow { height: 2; padding: 0 2; color: #aebed3; }
#page { height: 1fr; }
#content { width: 96%; max-width: 200; min-width: 80; height: auto; align-horizontal: center; padding: 1 2; }
.question { height: auto; min-height: 2; margin-bottom: 1; text-style: bold; }
#answers { height: auto; min-height: 12; }
.answer-box { width: 1fr; height: auto; min-height: 12; padding: 1 2; border: round #34465d; }
#plain-box { margin-right: 1; border: round #d9b66f; }
#rag-box { border: round #8ed6dc; }
.box-title { height: 2; text-style: bold; color: #8ed6dc; }
#plain-box .box-title { color: #d9b66f; }
.answer { height: auto; min-height: 4; }
.meta { height: auto; margin-top: 1; color: #aebed3; }
#evidence { height: auto; min-height: 12; margin-top: 1; padding: 1 2; border: round #34465d; }
#sources { height: auto; }
#chunk-select { margin-top: 1; }
#chunk-text { height: auto; margin-top: 1; }
#result-summary { height: auto; margin: 1 0; color: #e7c47b; }
