Screen {
    background: #101722;
    color: #dbe4f0;
}

#brand {
    height: 3;
    padding: 1 2 0 2;
    background: #172232;
}

#title {
    width: 22;
    color: #8ed6dc;
    text-style: bold;
}

#subtitle {
    width: 1fr;
    text-align: right;
    color: #899ab2;
}

#configuration {
    height: 5;
    padding: 1 2 0 2;
    background: #141e2c;
}

.config-label {
    width: auto;
    height: 3;
    padding: 1 1 0 0;
    color: #aebed3;
}

.n-label {
    margin-left: 3;
}

#model-select {
    width: 28;
}

#recent-select {
    width: 10;
}

#interval-label {
    width: 1fr;
    padding: 1 0 0 3;
    color: #8294aa;
}

#sessions {
    height: 1fr;
    padding: 1 1 0 1;
}

.session-panel {
    width: 1fr;
    min-width: 50;
    margin: 0 1;
    padding: 1;
    border: round #34465d;
    background: #141e2c;
}

.session-title {
    height: 2;
    color: #8ed6dc;
    text-style: bold;
}

.chat {
    height: 1fr;
    min-height: 10;
    padding: 0 1;
    background: #101925;
    border: solid #26384d;
}

.stats {
    height: 8;
    margin-top: 1;
    padding: 0 1;
    color: #aebed3;
    background: #192536;
}

#message-input {
    height: 3;
    margin: 0 2;
    border: tall #34465d;
    background: #101925;
}

#message-input:focus {
    border: tall #79c5d8;
}

#actions {
    height: 4;
    padding: 0 2;
}

Button {
    width: 1fr;
    min-width: 18;
    margin: 1 1 0 0;
    border: none;
}

Button.-primary {
    background: #386679;
    color: #f1f8fa;
}

Button.-primary:hover {
    background: #467d92;
}

Button.clear {
    margin-right: 0;
    background: #493a42;
    color: #efd9df;
}

#legend {
    height: 2;
    padding: 0 2;
    color: #8294aa;
}

#status {
    height: 2;
    padding: 0 2;
    color: #8ed6dc;
}

Footer {
    background: #172232;
    color: #9dafc6;
}
