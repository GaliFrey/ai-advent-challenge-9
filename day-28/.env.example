# Облачные вызовы выполняются только при включённом переключателе в TUI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Необязательно: по умолчанию читается только секция mcp_servers.webtutor-docs
# из ~/.codex/config.toml; значения env и другие секции не загружаются.
# WEBTUTOR_MCP_COMMAND=/usr/bin/node-22
# WEBTUTOR_MCP_ARGS=["/absolute/path/to/webtutor-docs/dist/index.mjs"]
