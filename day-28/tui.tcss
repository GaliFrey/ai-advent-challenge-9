Screen { layout: vertical; }
#brand { height: 2; padding: 0 1; color: $accent; text-style: bold; }
#toolbar, #turnbar { height: 3; padding: 0 1; }
#toolbar Select { width: 1fr; }
#toolbar Button { min-width: 10; margin-left: 1; }
#turnbar Select { width: 1fr; }
#repeat { width: 34; margin-left: 1; }
#status { height: 2; padding: 0 1; color: $warning; }
#tabs { height: 1fr; }
TabPane { padding: 0 1; }
#answers { height: 1fr; }
.answer-column { width: 1fr; border: solid $primary; padding: 0 1; }
.heading { height: 1; text-style: bold; color: $accent; }
.metrics { height: auto; min-height: 4; max-height: 8; }
.answer-scroll { height: 1fr; }
#local-answer, #cloud-answer { height: auto; }
#search-details { height: auto; padding: 1 0; }
#sources { height: 3; }
#source-text, #memory-details { height: auto; }
#notes { height: 6; }
#memory-details { padding: 1; }
#settings-scroll Label { height: auto; padding-top: 1; }
#settings-scroll Input, #settings-scroll Select { width: 65; max-width: 100%; }
.switch-row { height: 3; }
.switch-row Label { width: 65; max-width: 80%; }
.switch-row Switch { width: auto; }
#composer { height: 6; padding: 0 1; }
#question { width: 1fr; height: 5; }
#send { margin-left: 1; height: 3; width: 16; }
Footer { height: 1; }

#ollama-scroll { padding: 1; }
#ollama-status { height: auto; padding-bottom: 1; color: $accent; }
#ollama-buttons { height: 3; margin-bottom: 1; }
#ollama-buttons Button { margin-right: 1; }
#ollama-model { width: 65; max-width: 100%; }
#ollama-selected, #ollama-model-details, #ollama-loaded { height: auto; padding: 1 0; }

Collapsible { padding: 0; border: none; }
#local-diagnostics, #cloud-diagnostics, #search-diagnostics, #memory-diagnostics { height: auto; }
Screen.compact #brand, Screen.compact #status { height: 1; }
Screen.compact #toolbar Button { min-width: 8; margin-left: 0; }
Screen.compact #repeat { width: 12; }
Screen.compact #composer { height: 3; }
Screen.compact #question { height: 3; }
Screen.compact .metrics { min-height: 1; max-height: 2; }
Screen.compact #send { width: 12; }
Screen.compact #notes { height: 4; }
