Screen {
    background: #101722;
    color: #dbe4f0;
}
#brand {
    height: 3;
    padding: 1 2 0 2;
    background: #172232;
}
#title { width: 22; color: #8ed6dc; text-style: bold; }
#subtitle { width: 1fr; text-align: right; color: #899ab2; }
#workspace { padding: 0 2; }
.section { margin-top: 1; margin-bottom: 1; color: #98abc2; }
#prompts { height: 16; }
#prompts TabPane { padding: 0; }
#prompt-1, #prompt-2 {
    height: 12;
    border: round #34465d;
    background: #141e2c;
}
#prompt-1:focus, #prompt-2:focus { border: round #79c5d8; }
#actions { height: 3; margin: 1 0; }
Button { margin-right: 1; min-width: 18; border: none; }
Button.-primary { background: #386679; color: #f1f8fa; }
Button.-primary:hover { background: #467d92; }
#phase { height: 2; color: #8ed6dc; text-style: bold; }
#metrics { height: 8; background: #141e2c; }
#metrics > .datatable--header { background: #253447; color: #aebed3; text-style: bold; }
#metrics > .datatable--odd-row { background: #192536; }
#metrics > .datatable--even-row { background: #141e2c; }
#legend { height: auto; margin-top: 1; color: #8b9db4; }
#answers-1, #answers-2 { height: 1fr; }
#tabs { height: 1fr; min-height: 12; }
ContentSwitcher { height: 1fr; }
TabPane { height: 1fr; padding: 1 0; }
.answer-scroll { height: 1fr; padding: 1 2; border: round #34465d; background: #141e2c; }
.answer-scroll Static { width: 1fr; height: auto; }
.comparison-title { margin: 1 0 0 0; color: #8ed6dc; text-style: bold; }
.comparison-meta { color: #aebed3; }
.comparison-preview { margin-bottom: 1; padding: 0 1; border-left: tall #34465d; color: #dbe4f0; }
#saved { height: auto; margin: 1 0; color: #8190a7; }
Footer { background: #172232; color: #9dafc6; }
