Screen { background: #101722; color: #dbe4f0; }
Static { height: auto; }
#brand { height: 2; padding: 0 2; text-style: bold; color: #8ed6dc; background: #172232; }
#toolbar { height: 3; padding: 0 1; }
#sessions { width: 1fr; }
Button { width: auto; min-width: 12; margin-left: 1; }
#status { height: 2; padding: 0 2; color: #e7c47b; }
#workspace { height: 1fr; }
#chat-scroll { width: 1fr; border: round #8ed6dc; padding: 1 2; }
#sidebar { width: 45; border: round #34465d; padding: 0 2; }
#sidebar Input { height: 3; }
.heading { color: #8ed6dc; text-style: bold; margin-top: 0; margin-bottom: 0; }
#think-row { height: 3; align-vertical: middle; }
#think-row Static { width: 1fr; padding-top: 1; }
#thinking { width: auto; }
#note { color: #a9b9cc; margin-top: 1; }
#composer { height: 6; padding: 0 1; }
#input { width: 1fr; height: 6; }
#send { width: 18; height: 3; margin-top: 1; }
